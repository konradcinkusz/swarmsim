{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/konradcinkusz/swarmsim/contracts/rosbridge/swarm_mission.v1.schema.json",
  "title": "/swarm/mission payload (v1)",
  "description": "A mission dispatched by SwarmApi.Api to the swarm. Waypoints are world-frame ENU metres.",
  "type": "object",
  "required": ["version", "mission_id", "type", "waypoints", "drone_count", "spacing_m"],
  "additionalProperties": false,
  "properties": {
    "version": { "const": 1 },
    "mission_id": { "type": "string", "format": "uuid" },
    "type": { "enum": ["waypoint", "formation"] },
    "formation": { "enum": ["line", "v"], "description": "Follower layout; used only when type is 'formation'. Defaults to 'line'." },
    "waypoints": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "array",
        "prefixItems": [{ "type": "number" }, { "type": "number" }, { "type": "number" }],
        "minItems": 3,
        "maxItems": 3
      }
    },
    "drone_count": { "type": "integer", "minimum": 1 },
    "spacing_m": { "type": "number", "exclusiveMinimum": 0 }
  }
}
