# syntax=docker/dockerfile:1
#
# swarmsim simulation image: ROS 2 Humble + PX4 SITL + Gazebo Harmonic, MAVROS,
# rosbridge and the swarm_coordination package.
#
# Built and flown by .github/workflows/sim-smoke.yml (headless, CPU only); the GUI path
# stays a manual check — see ../docs/adr/0004-ci-scope-for-simulation-stack.md and its
# amendment. A cold build takes most of an hour, which is why an agent sandbox should
# not try it.
#
# Three stages:
#   gz     — ROS 2 Humble plus Gazebo Harmonic, shared by the two below.
#   px4    — PX4's toolchain and its build-time Python packages; compiles SITL.
#   (last) — the runtime: MAVROS built from source, rosbridge, the swarm_coordination
#            package, and the PX4 tree from `px4` without the toolchain's pip packages.
# The split is not about a slim binary: PX4 SITL runs from its checked-out tree
# (ROMFS, the airframe scripts, the `build/` tree `make` produces), so the runtime still
# carries the whole checkout. It is about what the runtime must NOT carry — see the
# `px4` stage.

ARG PX4_VERSION=v1.15.0
# MAVROS and the mavlink message package it builds against, pinned like PX4 (see the
# MAVROS step in the last stage for why they are built rather than installed).
ARG MAVROS_VERSION=2.15.1
ARG MAVLINK_RELEASE=2026.9.9-1

# ---------------------------------------------------------------------------
FROM ros:humble-ros-base AS gz

ARG DEBIAN_FRONTEND=noninteractive
SHELL ["/bin/bash", "-o", "pipefail", "-c"]

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        git \
        gnupg \
        lsb-release \
        sudo \
        wget \
    && rm -rf /var/lib/apt/lists/*

# Gazebo Harmonic, per docs/adr/0001. Installed here rather than by PX4's installer:
# PX4 v1.15.0's Tools/setup/ubuntu.sh installs Gazebo *Garden* on 22.04 — end of life
# since 2024-11 — so the `px4` stage runs it with --no-sim-tools. PX4 v1.15's gz_bridge
# looks for Harmonic's gz-transport13 first. The `gz-harmonic` metapackage brings the
# -dev packages gz_bridge compiles against and the `gz` CLI the entrypoint runs; it is
# installed without recommends, as PX4's installer installs its own Gazebo.
RUN wget -q https://packages.osrfoundation.org/gazebo.gpg \
        -O /usr/share/keyrings/pkgs-osrf-archive-keyring.gpg \
    && echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/pkgs-osrf-archive-keyring.gpg] http://packages.osrfoundation.org/gazebo/ubuntu-stable $(lsb_release -cs) main" \
        > /etc/apt/sources.list.d/gazebo-stable.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends gz-harmonic \
    && rm -rf /var/lib/apt/lists/* \
    && gz sim --versions

# ---------------------------------------------------------------------------
FROM gz AS px4

ARG PX4_VERSION
ARG DEBIAN_FRONTEND=noninteractive
SHELL ["/bin/bash", "-o", "pipefail", "-c"]

WORKDIR /opt
# --depth 1 on the tag, not a branch: reproducible, and avoids pulling PX4's full
# multi-year history (large) for a build that only ever needs one commit.
RUN git clone --branch "${PX4_VERSION}" --recursive --depth 1 \
        https://github.com/PX4/PX4-Autopilot.git PX4-Autopilot

WORKDIR /opt/PX4-Autopilot
# PX4's own dependency installer: compiler toolchain and the Python packages its build
# generates code with. This is the single source of truth for "what PX4 needs to build",
# which is why DL3008 (pin apt versions) is suppressed for this file rather than
# hand-duplicated here (see ../.hadolint.yaml).
#
# Those Python packages go to /root/.local and include NumPy 2 — which must never reach
# the runtime stage: ROS 2 Humble's message modules are compiled against NumPy 1, and
# with NumPy 2 first on the path every ROS Python node (rosbridge, the coordination
# nodes) fails to import its messages. Only the built tree leaves this stage.
RUN ./Tools/setup/ubuntu.sh --no-nuttx --no-sim-tools \
    && rm -rf /var/lib/apt/lists/*

# Compiles PX4 SITL only. Not `make px4_sitl_default gz_x500`: in PX4 v1.15, gz_x500 is
# a custom *run* target (src/modules/simulation/gz_bridge/CMakeLists.txt runs the px4
# binary with PX4_SIM_MODEL=gz_x500), so naming it here would start the simulation
# inside `docker build` and never return. The airframe is chosen at run time instead,
# by PX4_SIM_MODEL in simulation/px4-configs/x500_common.env.
RUN make px4_sitl_default

# CMake leaves gz_bridge out silently when it cannot find Gazebo, and the image would
# then build fine and fly nothing. Fail here instead.
RUN test -n "$(find build/px4_sitl_default -name 'libmodules__simulation__gz_bridge.a' -print -quit)" \
    || { echo "PX4 was built without gz_bridge: Gazebo's gz-transport was not found" >&2; exit 1; }

# ---------------------------------------------------------------------------
FROM gz

ARG MAVROS_VERSION
ARG MAVLINK_RELEASE
ARG DEBIAN_FRONTEND=noninteractive
SHELL ["/bin/bash", "-o", "pipefail", "-c"]

# rosbridge is what SwarmApi.Api connects to.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        geographiclib-tools \
        libgl1 \
        libgl1-mesa-dri \
        mesa-utils \
        python3-colcon-common-extensions \
        python3-rosdep \
        ros-humble-rosbridge-suite \
        tmux \
    && rm -rf /var/lib/apt/lists/*

# MAVROS bridges each PX4 instance's onboard MAVLink port into ROS 2 for the coordination
# nodes. It is built from its release tag, not installed: in September 2026 the ROS
# Humble apt repository had no ros-humble-mavros package at all, although rosdistro
# releases 2.15.1 for Humble (the first SITL smoke run failed on exactly that), and a
# source build pins it the way PX4_VERSION pins PX4. The mavlink message package comes
# from its Humble release tag for the same reason; rosdep installs everything else.
WORKDIR /opt/mavros_ws
RUN git clone --depth 1 --branch "${MAVROS_VERSION}" \
        https://github.com/mavlink/mavros.git src/mavros \
    && git clone --depth 1 --branch "release/humble/mavlink/${MAVLINK_RELEASE}" \
        https://github.com/ros2-gbp/mavlink-gbp-release.git src/mavlink \
    && apt-get update \
    && { rosdep init 2>/dev/null || true; } \
    && rosdep update --rosdistro humble \
    && rosdep install --from-paths src --ignore-src -y --rosdistro humble \
        -t buildtool -t buildtool_export -t build -t build_export -t exec \
    && rm -rf /var/lib/apt/lists/* \
    && source /opt/ros/humble/setup.bash \
    && colcon build --packages-up-to mavros \
        --cmake-args -DCMAKE_BUILD_TYPE=Release -DBUILD_TESTING=OFF \
    && rm -rf build log src

# MAVROS refuses to start without the egm96-5 geoid, which no package ships; fail the
# build here rather than at the first flight if the download did not land.
RUN geographiclib-get-geoids egm96-5; \
    compgen -G "/usr/share/GeographicLib/geoids/egm96-5*" \
    || compgen -G "/usr/local/share/GeographicLib/geoids/egm96-5*" \
    || { echo "GeographicLib geoid dataset egm96-5 is missing; MAVROS would not start" >&2; exit 1; }

COPY --from=px4 /opt/PX4-Autopilot /opt/PX4-Autopilot

# The coordination package last, so a change to it rebuilds these layers only — not PX4
# or MAVROS. Built on top of the MAVROS workspace, so sourcing its setup.bash brings
# MAVROS along.
COPY swarm_coordination /opt/swarmsim/ws/src/swarm_coordination
WORKDIR /opt/swarmsim/ws
RUN source /opt/mavros_ws/install/setup.bash \
    && colcon build --packages-select swarm_coordination \
    && rm -rf build log

COPY simulation/worlds /opt/swarmsim/worlds
COPY simulation/px4-configs /opt/swarmsim/px4-configs
COPY docker/entrypoint.sh /opt/swarmsim/entrypoint.sh
RUN chmod +x /opt/swarmsim/entrypoint.sh
WORKDIR /opt/swarmsim

# 1 = Gazebo server only (no GPU/display needed); 0 = also start the GUI. Interpreted
# by entrypoint.sh, not by PX4 — PX4's own script treats any non-empty value as headless.
ENV HEADLESS=1

LABEL org.opencontainers.image.source="https://github.com/konradcinkusz/swarmsim"
LABEL org.opencontainers.image.description="ROS 2 Humble + PX4 SITL + Gazebo Harmonic simulation environment for swarmsim"

EXPOSE 9090

ENTRYPOINT ["/opt/swarmsim/entrypoint.sh"]
