# Copy to docker/.env (gitignored) to set these for every `docker compose` run in this
# directory. Every variable is optional; unset, each takes the default described here.

# 1 (default) = Gazebo server only; 0 = also the GUI (use docker-compose.gui.yml).
#HEADLESS=1

# Spawn only the first N of simulation/px4-configs/drone_*.env (default: all five).
#SWARM_DRONE_COUNT=3

# Bearer auth against the `auth` profile's local authservice (docs/adr/0005). Unset
# keeps SwarmApi.Api in Open mode. authservice speaks plain http inside the compose
# network, so JWT metadata over http has to be allowed explicitly alongside it.
#SWARM_AUTH_AUTHORITY=http://authservice:8080
#SWARM_AUTH_REQUIRE_HTTPS_METADATA=false

# The authservice signing key is multi-line PEM: export it in your shell rather than
# putting it here — see the `authservice` service in docker-compose.yml for how to
# generate one. Never commit it.
#AUTHSERVICE_JWT_PRIVATE_KEY_PEM=
