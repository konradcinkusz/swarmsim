# Shared defaults for every swarm member. docker/entrypoint.sh sources this file first
# and then drone_<n>.env, so a per-drone file can override anything set here.
#
# Plain KEY=value lines only: the entrypoint sources them in a subshell per drone and
# passes the values to PX4 as environment variables (see simulation/px4-configs/README.md
# for how each one is consumed by PX4 v1.15's init scripts).

# Selects PX4's airframe by name: init.d-posix/rcS resolves it to 4001_gz_x500.
PX4_SIM_MODEL=gz_x500

# The Gazebo world every drone joins. Must match both the file name under
# simulation/worlds/ and the <world name="..."> inside it.
PX4_GZ_WORLD=swarmsim_empty
