# Swarm member 1. Sourced by docker/entrypoint.sh after x500_common.env.

# PX4 SITL instance index (px4 -i). PX4 derives everything port- and ID-shaped from it:
# MAV_SYS_ID = instance + 1, offboard MAVLink on UDP 14580+instance (remote 14540+instance).
PX4_INSTANCE=0

# ROS 2 namespace and tmux session name for this drone.
ROS_NAMESPACE=drone_1

# Spawn pose in the Gazebo world frame: x,y,z,roll,pitch,yaw (metres, radians).
# Drones stand 3 m apart along +y, so no two x500s (about 0.5 m across) share a pad.
# This is also each drone's local-frame origin: PX4 reports positions relative to
# where it spawned, so anything combining drones must add this offset back.
PX4_GZ_MODEL_POSE=0,0,0,0,0,0
