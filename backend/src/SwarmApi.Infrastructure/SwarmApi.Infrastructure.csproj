<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>SwarmApi.Infrastructure</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- A plain classlib has no implicit reference to Microsoft.Extensions.* (DI,
         Configuration, Logging) the way an Sdk.Web project does — needed here for
         ServiceCollectionExtensions.AddSwarmBridgeAsync. Same fix as ServiceDefaults. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- Not part of Microsoft.AspNetCore.App's shared framework, unlike everything else
         referenced here — see Directory.Packages.props and
         docs/adr/0005-mcp-server-and-bearer-auth.md. -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SwarmApi.Application\SwarmApi.Application.csproj" />
    <ProjectReference Include="..\SwarmApi.Domain\SwarmApi.Domain.csproj" />
  </ItemGroup>

</Project>
