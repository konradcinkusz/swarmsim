<Project>
  <PropertyGroup>
    <CentralPackageVersionOverrideEnabled>false</CentralPackageVersionOverrideEnabled>
  </PropertyGroup>
  <ItemGroup>
    <!-- Test-only dependencies. Runtime code (SwarmApi.Domain/Application/Infrastructure/
         ServiceDefaults/Api) has zero third-party NuGet packages by design — everything it
         needs (minimal APIs, System.Net.WebSockets, health checks) ships in the ASP.NET
         Core shared framework. Per REPO-BASELINE.md §4b's dependency budget: this table is
         the whole budget, and it is a test-tooling budget. -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="8.0.31" />
    <PackageVersion Include="coverlet.collector" Version="10.0.1" />
  </ItemGroup>
</Project>
