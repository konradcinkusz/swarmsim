# --- Secrets -----------------------------------------------------------------
# Named explicitly rather than as a blanket `*.env`: that pattern once swallowed
# simulation/px4-configs/drone_<n>.env — committed configuration that happens to use
# the extension — so a fresh clone had no drones to spawn and nothing said so. A local
# secrets file is `.env`, `.env.<something>` or `*.secret.env`; nothing else is ignored
# by extension alone. `.github/workflows/ci.yml` (job `simulation-config`) fails if the
# drone configs ever go missing again.
.env
.env.*
!.env.example
*.secret.env

# --- .NET ----------------------------------------------------------------
backend/**/bin/
backend/**/obj/
*.user
.vs/

# --- Python / ROS 2 -----------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.venv/
venv/

# colcon workspace build output (never committed; regenerated by colcon build)
swarm_coordination/build/
swarm_coordination/install/
swarm_coordination/log/
build/
install/
log/

# --- Simulation -----------------------------------------------------------
# PX4-Autopilot is cloned at image build time (see docker/Dockerfile.sim); the
# source tree is never vendored into this repository.
simulation/PX4-Autopilot/

# --- Docker / containers ---------------------------------------------------
*.last-image-tag

# --- Test output -------------------------------------------------------------
# The e2e fixture's log of the SwarmApi.Api it starts (e2e/conftest.py).
e2e/api.log

# --- Editors / OS -----------------------------------------------------------
.idea/
.DS_Store
Thumbs.db
*.swp

# --- Node (dashboard tooling, if any) ---------------------------------------
node_modules/

# --- Docs site --------------------------------------------------------------
# mkdocs build output — generated by `mkdocs build` / .github/workflows/pages.yml,
# never committed.
site/
